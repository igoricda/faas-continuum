// FaaS Continuum — example configuration of the node agent (JSONC).
// Copy it to config.jsonc and adjust it for the deployment. It accepts the
// // and /* */ comments.
// Precedence: flags > environment variables FAAS_* > config.jsonc > built-in
// defaults. The source of the defaults is Defaults in internal/config/config.go.
{
  // runtime: connection to the containerd (see Runtime in internal/config/config.go). Flags: -socket, -namespace, -socket-root
  "runtime": {
    // socket: the gRPC socket of the containerd (flag -socket, env FAAS_SOCKET). Default: "/run/containerd/containerd.sock"
    "socket": "/run/containerd/containerd.sock",
    // namespace: the namespace of the containerd that isolates the objects of the framework (flag -namespace, env FAAS_NAMESPACE). Default: "faas-continuum"
    "namespace": "faas-continuum",
    // socket_root: the directory on the host for the per instance Unix sockets between the agent and the watchdog (flag -socket-root, env FAAS_SOCKET_ROOT). Default: "/run/faas-continuum/sockets"
    "socket_root": "/run/faas-continuum/sockets"
  },

  // registry: persistence of the function definitions (see NewPersistentRegistry in internal/registry/persistence.go). Flag: -registry
  "registry": {
    // path: the JSON file that persists the function registry (env FAAS_REGISTRY). Default: "./faas-continuum-functions.json"
    "path": "./faas-continuum-functions.json",
    // allowed_registries: the list of registry hosts allowed in image_ref (env FAAS_REGISTRY_ALLOWED_REGISTRIES).
    // Default: [] (empty means any registry is allowed). Example: ["docker.io", "registry.example.com", "ghcr.io"].
    // When it is not empty, Register and Update reject an image_ref whose registry host is not in the list (400 INVALID_IMAGE_REF).
    "allowed_registries": []
  },

  // telemetry: collection and reporting (see Collector and Reporter in internal/telemetry). Flags: -cgroup-root, -report-interval
  "telemetry": {
    // enabled: the global switch of the telemetry collection (env FAAS_TELEMETRY_ENABLED). Default: true
    "enabled": true,
    // cgroup_root: the root of the cgroups v2 for the pressure, the CPU and the memory (flag -cgroup-root, env FAAS_CGROUP_ROOT). Default: "" (automatic detection, in general /sys/fs/cgroup); an empty value falls back to /proc/stat and /proc/meminfo without cgroups v2
    "cgroup_root": "",
    // proc_stat_path: the path of the CPU fallback (env FAAS_TELEMETRY_PROC_STAT_PATH). Default: "/proc/stat"
    "proc_stat_path": "/proc/stat",
    // meminfo_path: the path of the memory fallback (env FAAS_TELEMETRY_MEMINFO_PATH). Default: "/proc/meminfo"
    "meminfo_path": "/proc/meminfo",
    // powercap_root: the root of the Power Capping Framework for the RAPL energy counters (env FAAS_TELEMETRY_POWERCAP_ROOT). Default: "/sys/class/powercap"
    "powercap_root": "/sys/class/powercap",
    // power_supply_root: the root of the power_supply subsystem for the battery and the instantaneous power (env FAAS_TELEMETRY_POWER_SUPPLY_ROOT). Default: "/sys/class/power_supply"
    "power_supply_root": "/sys/class/power_supply",
    // report_interval: the period of the autonomous report to the monitor (flag -report-interval, env FAAS_REPORT_INTERVAL). Default: "10s" — only used when monitor_url is set
    "report_interval": "10s",
    // invocation_sample_interval: the period of the sampling of the resource profile per invocation, through the metrics of the containerd (env FAAS_TELEMETRY_INVOCATION_SAMPLE_INTERVAL). Default: "200ms"
    "invocation_sample_interval": "200ms"
  },

  // nodeapi: the HTTP API of the node (see Server in internal/nodeapi/server.go). Flags: -listen, -host, -node-id, -monitor-url, -default-timeout, -reconcile-timeout, -late-queue-cap, -late-cap-ms
  "nodeapi": {
    // listen: the address where the API of the node listens (flag -listen, env FAAS_LISTEN). Default: ":8080"
    "listen": ":8080",
    // host: the public host used to compose the host, function and name path (flag -host, env FAAS_HOST). Default: "" (inherits listen)
    "host": "",
    // node_id: the identifier reported in the telemetry (flag -node-id, env FAAS_NODE_ID). Default: "" (the hostname)
    "node_id": "",
    // monitor_url: the endpoint of the monitor of the arbiter for the periodic report (flag -monitor-url, env FAAS_MONITOR_URL). Default: "" (disables the periodic report; the piggyback stays active)
    "monitor_url": "",
    // default_timeout: the invocation timeout when the function and the objective omit it (flag -default-timeout, env FAAS_DEFAULT_TIMEOUT). Default: "90s" (it covers a cold import of the detection model of 30 to 60 seconds)
    "default_timeout": "90s",
    // reconcile_timeout: the deadline of the startup reconciliation of the surviving containers (flag -reconcile-timeout, env FAAS_RECONCILE_TIMEOUT). Default: "60s"
    "reconcile_timeout": "60s",
    // max_management_body_bytes: the ceiling of the body of the management routes POST and PUT (env FAAS_NODEAPI_MAX_MANAGEMENT_BODY_BYTES). Default: 65536
    "max_management_body_bytes": 65536,
    // max_invoke_body_bytes: the ceiling of the body of the invocation (env FAAS_NODEAPI_MAX_INVOKE_BODY_BYTES). Default: 8388608 (8 MiB) — unified with the limit of the gateway of the arbiter
    "max_invoke_body_bytes": 8388608,
    // max_function_output_bytes: the ceiling of the buffered function output of an invocation (env FAAS_NODEAPI_MAX_FUNCTION_OUTPUT_BYTES). Default: 8388608 (8 MiB)
    "max_function_output_bytes": 8388608,
    // read_header_timeout: the ReadHeaderTimeout of the HTTP server (env FAAS_NODEAPI_READ_HEADER_TIMEOUT). Default: "10s"
    "read_header_timeout": "10s",
    // idle_timeout: the IdleTimeout of the HTTP server for the keep alive (env FAAS_NODEAPI_IDLE_TIMEOUT). Default: "120s"
    "idle_timeout": "120s",
    // late_queue_cap: the ceiling of the queue of the late report sender; above the ceiling the report is dropped and counted in late_dropped_total (flag -late-queue-cap, env FAAS_NODEAPI_LATE_QUEUE_CAP). Default: 1024
    "late_queue_cap": 1024,
    // late_cap_ms: the ceiling of the detached opted-in execution in milliseconds, with lateCap = min(nodeTimeout, late_cap_ms) (flag -late-cap-ms, env FAAS_NODEAPI_LATE_CAP_MS). Default: 90000 (90 seconds)
    "late_cap_ms": 90000
  },

  // scaling: the autoscaling settings (see Manager in internal/pool/pool.go)
  "scaling": {
    // default_scale_down_timeout: the idle time before scaling down to min_instances when the function omits idle_timeout (flag -default-scale-down-timeout, env FAAS_DEFAULT_SCALE_DOWN_TIMEOUT). Default: "15m"
    "default_scale_down_timeout": "15m"
  },

  // arbitro: the settings of the central gateway (see Server and Gateway in internal/arbitro/server and internal/arbitro/gateway). Flags: -url, -listen, -credential, -nodes, -stale-after, -history, -history-cap, -history-sync, -invocation-log, -selflearning-min-samples, -selflearning-throughput-window, -max-race-fanout
  "arbitro": {
    // url: the endpoint of the API of the arbiter (flag -arbitro-url, env FAAS_ARBITRO_URL). Default: ""
    "url": "",
    // layer: the network layer (flag -layer, env FAAS_LAYER). Default: "borda"
    "layer": "borda",
    // listen: the address where the arbiter listens (flag -listen, env FAAS_ARBITRO_LISTEN). Default: ":8090"
    "listen": ":8090",
    // nodes: the path of the registry of nodes (flag -nodes, env FAAS_ARBITRO_NODES_PATH). Default: "./faas-continuum-nodes.json"
    "nodes_path": "./faas-continuum-nodes.json",
    // credential_path: the path of the credential file (flag -credential, env FAAS_ARBITRO_CREDENTIAL). Default: "./faas-continuum-arbitro-credential.json"
    "credential_path": "./faas-continuum-arbitro-credential.json",
    // node_tokens_path: the path of the file with the per node tokens (flag -node-tokens, env FAAS_ARBITRO_NODE_TOKENS_PATH). Default: "./faas-continuum-node-tokens.json"
    "node_tokens_path": "./faas-continuum-node-tokens.json",
    // stale_after: the time without a last_seen until the node is considered unavailable (flag -stale-after, env FAAS_STALE_AFTER). Default: "90s"
    "stale_after": "90s",
    // history_path: the path of the history file (flag -history, env FAAS_ARBITRO_HISTORY_PATH). Default: "./faas-continuum-history.json"
    "history_path": "./faas-continuum-history.json",
    // history_sync: the persistence mode of the history, either batched (a ticker of 500 ms plus the coalesce) or strict (an fsync per append). Default: "batched"
    "history_sync": "batched",
    // selector: the selector in production (flag -selector, envs ARBITRO_SELECTOR and FAAS_ARBITRO_SELECTOR). "risk" is the canonical RiskSelector and the default, "hl" is the pure QueueSelector, which is the baseline of the hard limits without learning. Any other value aborts the startup
    "selector": "risk",
    // history_cap: the capacity of historical entries per segment (flag -history-cap, env FAAS_ARBITRO_HISTORY_CAP). Default: 1000
    "history_cap": 1000,
    // history_retention: the retention window of the history by age (flag -history-retention, envs ARBITRO_HISTORY_RETENTION and FAAS_ARBITRO_HISTORY_RETENTION). Default: "1h"; zero disables the cut; a positive value has to cover the throughput window, otherwise the startup aborts. The invocation log keeps the complete record
    "history_retention": "1h",
    // invocation_log_path: the append-only log of the invocations (JSONL, one Entry per line, without a ceiling) for the analysis; an empty value disables it (flag -invocation-log, env FAAS_ARBITRO_INVOCATION_LOG_PATH). Default: ""
    "invocation_log_path": "",
    // min_samples: the minimum number of samples of the history per segment (flag -selflearning-min-samples, env FAAS_ARBITRO_MIN_SAMPLES). Default: 20. It is consumed by the summary of the history in the GET /nodes
    "min_samples": 20,
    // throughput_window: the window of the history for the throughput and the cost (flag -selflearning-throughput-window, env FAAS_ARBITRO_THROUGHPUT_WINDOW). Default: "60s" (the code default is in internal/config/config.go and in the flag of cmd/arbitro/main.go). It feeds the ExpectedCost of the RiskSelector and the history summary of the GET /nodes
    "throughput_window": "10m",
    // max_race_fanout: the ceiling of node attempts per invocation in the gateway (flag -max-race-fanout, env FAAS_ARBITRO_MAX_RACE_FANOUT). Default: 3
    "max_race_fanout": 3,
    // max_cpu_pct: the CPU limit in percent that marks a node as overloaded (flag -max-cpu-pct, env FAAS_ARBITRO_MAX_CPU_PCT). Default: 85 (a value of zero or less aborts the startup)
    "max_cpu_pct": 85,
    // max_mem_pct: the memory limit in percent that marks a node as overloaded (flag -max-mem-pct, env FAAS_ARBITRO_MAX_MEM_PCT). Default: 90 (a value of zero or less aborts the startup)
    "max_mem_pct": 90,
    // max_psi_avg10: the limit of the PSI average pressure in percent, which sums the CPU and the memory with the full memory (flag -max-psi-avg10, env FAAS_ARBITRO_MAX_PSI_AVG10). Default: 25 (a value of zero or less aborts the startup)
    "max_psi_avg10": 25,
    // node_limits: the override of the hard limits per node, where the key is the node_id of the registry. The entry is partial: a field of zero or absent inherits the global value above. Only the arbiter consumes it and there is no flag or environment variable for it, since a map cannot be expressed as a scalar. It affects only the stage of the hard limits, which is the overload filter and the overloaded status of the GET /nodes. A negative value, a NaN, an infinity or an empty node_id aborts the startup; a node_id with no registered node only produces a warning. Default: omitted, so every node uses the global limits. Example: {"borda-01": {"max_cpu_pct": 60}, "nevoa-01": {"max_cpu_pct": 95, "max_mem_pct": 70, "max_psi_avg10": 10}}
    "node_limits": {},
    // invoke_timeout: the default invocation timeout of the gateway (flag -invoke-timeout, env FAAS_ARBITRO_INVOKE_TIMEOUT). Default: "90s" (a value of zero or less aborts the startup)
    "invoke_timeout": "90s",
    // cloud_fallback_path: the path of the persistence of the cloud fallback configuration (flag -cloud-fallback, env FAAS_ARBITRO_CLOUD_FALLBACK). Default: "./faas-continuum-cloud-fallback.json"
    "cloud_fallback_path": "./faas-continuum-cloud-fallback.json",
    // function_categories: the explicit map from the variant to the category, sent as function_categories in the POST /nodes (flag -function-categories, env FAAS_FUNCTION_CATEGORIES). Default: omitted, with no derivation from the local registry. Example: {"alpr-yolo-tiny": "alpr-yolo"}
    "function_categories": {},
    // risk_half_life: the half life of the temporal decay of the RiskSelector (flag -risk-halflife, envs ARBITRO_RISK_HALFLIFE and FAAS_ARBITRO_RISK_HALFLIFE). Default: "10m"
    "risk_half_life": "10m",
    // risk_epsilon: the risk epsilon of the conformal inference of the RiskSelector (flag -risk-epsilon, envs ARBITRO_RISK_EPSILON and FAAS_ARBITRO_RISK_EPSILON). Default: 0.05
    "risk_epsilon": 0.05,
    // risk_aci_gamma: the gamma of the conformal inference of the RiskSelector (flag -risk-aci-gamma, envs ARBITRO_RISK_ACI_GAMMA and FAAS_ARBITRO_RISK_ACI_GAMMA). Default: 0.01
    "risk_aci_gamma": 0.01,
    // risk_nmin: the nmin of the RiskSelector, below which a node is in probation (flag -risk-nmin, envs ARBITRO_RISK_NMIN and FAAS_ARBITRO_RISK_NMIN). Default: 3
    "risk_nmin": 3,
    // risk_explore: the probability of exploration ahead of the queue of the RiskSelector (flag -risk-explore, envs ARBITRO_RISK_EXPLORE and FAAS_ARBITRO_RISK_EXPLORE). Default: 0.05
    "risk_explore": 0.05,
    // risk_stretch: the stretch of the effective deadline without an objective of the RiskSelector (flag -risk-stretch, envs ARBITRO_RISK_STRETCH and FAAS_ARBITRO_RISK_STRETCH). Default: 2.0
    "risk_stretch": 2.0,
    // risk_stretch_slo: the stretch of the effective deadline with an objective of the RiskSelector; zero disables it (flag -risk-stretch-slo, envs ARBITRO_RISK_STRETCH_SLO and FAAS_ARBITRO_RISK_STRETCH_SLO). Default: 0
    "risk_stretch_slo": 0,
    // risk_band: the tie tolerance of the band of the RiskSelector (flag -risk-band, envs ARBITRO_RISK_BAND and FAAS_ARBITRO_RISK_BAND). Default: 0.10
    "risk_band": 0.10,
    // risk_queue_allowance: the static queue ceiling of the RiskSelector (flag -risk-queue-allowance, envs ARBITRO_RISK_QUEUE_ALLOWANCE and FAAS_ARBITRO_RISK_QUEUE_ALLOWANCE). Default: 1.0
    "risk_queue_allowance": 1.0,
    // risk_default_servers: the servers assumed by the RiskSelector when there is no max_instances (flag -risk-default-servers, envs ARBITRO_RISK_DEFAULT_SERVERS and FAAS_ARBITRO_RISK_DEFAULT_SERVERS). Default: 1
    "risk_default_servers": 1,
    // risk_min_success: the minimum success probability of the RiskSelector (flag -risk-min-success, envs ARBITRO_RISK_MIN_SUCCESS and FAAS_ARBITRO_RISK_MIN_SUCCESS). Default: 0.5
    "risk_min_success": 0.5,
    // risk_priors: the JSON file with the priors of the RiskSelector (flag -risk-priors, envs ARBITRO_RISK_PRIORS and FAAS_ARBITRO_RISK_PRIORS). Default: "" (without priors)
    "risk_priors": ""
  }
}
